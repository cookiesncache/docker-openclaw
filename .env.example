# Copy to .env and fill in. Never commit the real .env.
# Generate a token, e.g.: openssl rand -hex 24
OPENCLAW_GATEWAY_TOKEN=changeme-generate-a-random-token
ANTHROPIC_API_KEY=sk-ant-...
TZ=America/New_York
# Leave false. Set true only if you reach the dashboard over plain HTTP with no TLS in front -
# without it, pairing will fail on a plain-HTTP LAN address.
OPENCLAW_ALLOW_INSECURE_AUTH=false

# Advanced. Inbound bind address for the gateway. Leave unset: the container uses 127.0.0.1 when
# Tailscale Serve is enabled and lan otherwise. Set to lan if something must reach IN - a reverse
# proxy, a dashboard widget, n8n/Home Assistant, or another container using the OpenAI-compatible
# endpoints. Does not affect OpenClaw reaching OUT to other containers.
#OPENCLAW_GATEWAY_BIND=

# Control UI allowed origins (CSRF protection) - set to the URL you reach the UI from,
# e.g. https://openclaw.YOUR-TAILNET.ts.net  (comma-separated for multiple). Recommended.
OPENCLAW_CONTROL_UI_ALLOWED_ORIGINS=

# Optional extra provider keys / bot tokens (uncomment + set if used):
#OPENAI_API_KEY=
#OPENROUTER_API_KEY=
#GEMINI_API_KEY=
#GROQ_API_KEY=
#XAI_API_KEY=
#ZAI_API_KEY=
#COPILOT_GITHUB_TOKEN=
#DISCORD_BOT_TOKEN=
#TELEGRAM_BOT_TOKEN=
#BRAVE_API_KEY=
