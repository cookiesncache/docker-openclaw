#!/usr/bin/with-contenv bash

# Ensure the config/state/workspace tree exists on the /config volume.
# HOME=/config, so OpenClaw resolves ~/.openclaw to /config/.openclaw.
mkdir -p \
    /config/.openclaw/state \
    /config/.openclaw/workspace

# Seed the default gateway config on first run, from /defaults (LSIO idiom).
if [[ ! -f /config/.openclaw/openclaw.json ]]; then
    echo "**** first run: seeding default openclaw.json from /defaults ****"
    cp /defaults/openclaw.json /config/.openclaw/openclaw.json
fi

# Resolve the inbound bind the same way svc-openclaw does, so the config file matches
# what the service is actually launched with. Fails open to `lan`.
OPENCLAW_RESOLVED_BIND="$(/usr/local/bin/openclaw-resolve-bind 2>/dev/null)" || OPENCLAW_RESOLVED_BIND="lan"
[[ -n "${OPENCLAW_RESOLVED_BIND}" ]] || OPENCLAW_RESOLVED_BIND="lan"
export OPENCLAW_RESOLVED_BIND

# Apply security-relevant Control UI / auth config each boot.
#   OPENCLAW_ALLOW_INSECURE_AUTH         accept auth over plain HTTP. Authoritative WHEN SET;
#                                        when unset the persisted value is left alone, so an
#                                        existing plain-HTTP install is not broken by an image
#                                        update. New installs get `false` from /defaults.
#   OPENCLAW_CONTROL_UI_ALLOWED_ORIGINS  comma-separated allowed origins for the Control UI
#                                        (CSRF/origin protection on a non-loopback bind), e.g.
#                                        https://openclaw.<tailnet>.ts.net
#   OPENCLAW_GATEWAY_BIND                inbound bind override (see openclaw-resolve-bind)
echo "**** applying control-UI/auth config (bind=${OPENCLAW_RESOLVED_BIND}, insecureAuth=${OPENCLAW_ALLOW_INSECURE_AUTH:-unset -> keeping existing}) ****"
node -e '
  const fs = require("fs"), p = "/config/.openclaw/openclaw.json";
  try {
    const c = JSON.parse(fs.readFileSync(p, "utf8"));
    c.gateway = c.gateway || {};
    const ui = c.gateway.controlUi = c.gateway.controlUi || {};
    const auth = c.gateway.auth = c.gateway.auth || {};

    // bind: resolved from OPENCLAW_GATEWAY_BIND / TAILSCALE_SERVE_PORT. The service passes
    // --bind as well; this keeps the file consistent with the running process.
    c.gateway.bind = process.env.OPENCLAW_RESOLVED_BIND || "lan";

    // allowInsecureAuth: env-authoritative WHEN SET, otherwise leave the persisted value.
    const raw = process.env.OPENCLAW_ALLOW_INSECURE_AUTH;
    if (raw != null && raw !== "") {
      ui.allowInsecureAuth = !["false","0","no","off"].includes(raw.toLowerCase());
    }

    // allowedOrigins: set only when provided (comma-separated)
    const origins = (process.env.OPENCLAW_CONTROL_UI_ALLOWED_ORIGINS || "")
      .split(",").map(s => s.trim()).filter(Boolean);
    if (origins.length) ui.allowedOrigins = origins;

    // auth.rateLimit: seed a sane default if unset; never override a user-set value
    if (auth.rateLimit == null) {
      auth.rateLimit = { maxAttempts: 10, windowMs: 60000, lockoutMs: 300000 };
    }

    fs.writeFileSync(p, JSON.stringify(c));

    // Name the symptom, not the mechanism: fail-closed is only correct if the resulting
    // error is findable by someone who just lost their dashboard.
    if (ui.allowInsecureAuth === false) {
      console.log("**** control-UI: insecure auth is OFF (bind=" + c.gateway.bind + "). If pairing fails on a plain http:// address, put TLS in front (Tailscale Serve / reverse proxy) or set OPENCLAW_ALLOW_INSECURE_AUTH=true ****");
    }
  } catch (e) { console.log("WARN: could not patch openclaw.json: " + e.message); }
'

# Hand the tree to the runtime user (abc, remapped to PUID/PGID by the base init).
lsiown -R abc:abc /config/.openclaw
